# Molde de variáveis de ambiente — COPIE para `.env` e preencha com seus valores.
#   cp .env.example .env


# --- PostgreSQL (warehouse) ---
DB_HOST=localhost
DB_PORT=5430
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=mkt_ads

# --- Looker Studio (role somente-leitura do BI) ---
# Senha do usuário `looker_ro` criado por sql/grant_looker_ro.sql.
LOGIN_LOOKER=senha_do_looker_ro

# --- ngrok ---
# Authtoken da sua conta ngrok (dashboard.ngrok.com) para expor o Postgres.
NGROK_AUTHTOKEN=seu_authtoken_do_ngrok
